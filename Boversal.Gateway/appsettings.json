{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "project-management-swagger": {
        "ClusterId": "project-management-cluster",
        "Order": 1,
        "Match": {
          "Path": "/project-management-service/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/project-management-service"
          }
        ]
      },
      "project-management-api-direct": {
        "ClusterId": "project-management-cluster",
        "Order": 2,
        "Match": {
          "Path": "/project-management-service/api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/project-management-service"
          }
        ]
      },
      "utility-swagger": {
        "ClusterId": "utility-cluster",
        "Order": 3,
        "Match": {
          "Path": "/utility-service/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/utility-service"
          }
        ]
      },
      "utility-api-direct": {
        "ClusterId": "utility-cluster",
        "Order": 4,
        "Match": {
          "Path": "/utility-service/api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/utility-service"
          }
        ]
      },
      "intellcoreservice-api-direct": {
        "ClusterId": "intellcoreservice-cluster",
        "Order": 5,
        "Match": {
          "Path": "/intellcoreservice/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/intellcoreservice"
          }
        ]
      },
      "intellcoreservice-api-root": {
        "ClusterId": "intellcoreservice-cluster",
        "Order": 6,
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "authenticate-service-api-direct": {
        "ClusterId": "authenticate-service-cluster",
        "Order": 7,
        "Match": {
          "Path": "/authenticate-service/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/authenticate-service"
          }
        ]
      }
    },
    "Clusters": {
      "project-management-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://project-management:8080"
          }
        }
      },
      "utility-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://utility:8080"
          }
        }
      },
      "intellcoreservice-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://intellcoreservice:8080"
          }
        }
      },
      "authenticate-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://authenticate-service:8080"
          }
        }
      }
    }
  }
}